APP_ENV=development
SECRET_KEY=change-this-development-secret-key-32chars
POSTGRES_USER=industrial
POSTGRES_PASSWORD=industrial
POSTGRES_DB=industrial
DATABASE_URL=postgresql+psycopg://industrial:industrial@postgres:5432/industrial
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
RAW_BUCKET=raw
RESULT_BUCKET=results
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
REVIEWER_EMAIL=reviewer@example.com
REVIEWER_PASSWORD=Reviewer123!
SUBMITTER_EMAIL=submitter@example.com
SUBMITTER_PASSWORD=Submitter123!
WORKER_CONCURRENCY=4
ACTIVE_TASK_LIMIT=20
REVIEW_LEASE_MINUTES=30
EXECUTION_LEASE_SECONDS=120
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=bitnamilegacy/minio:latest
PROMETHEUS_IMAGE=prom/prometheus:v3.3.0
